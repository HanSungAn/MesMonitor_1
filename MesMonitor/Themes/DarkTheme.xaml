<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main Backgrounds -->
    <SolidColorBrush x:Key="BgWindowBrush" Color="#0B132B"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#111B33"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#111B33"/>
    <SolidColorBrush x:Key="FooterBgBrush" Color="#0C1427"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#1C2541"/>
    <SolidColorBrush x:Key="SubCardBgBrush" Color="#161F38"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2D3B5A"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A506B"/>
    <SolidColorBrush x:Key="SubCardBorderBrush" Color="#2D3B5A"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2D3B5A"/>

    <!-- Text Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#64748B"/>

    <!-- Inputs & Controls -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#111B33"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A506B"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DropdownBgBrush" Color="#111B33"/>
    <SolidColorBrush x:Key="DropdownItemHoverBrush" Color="#1E293B"/>

    <!-- Navigation Menu -->
    <SolidColorBrush x:Key="NavButtonTextBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="NavButtonHoverTextBrush" Color="#FFFFFF"/>

    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridBgBrush" Color="#1C2541"/>
    <SolidColorBrush x:Key="DataGridRowBgBrush" Color="#1C2541"/>
    <SolidColorBrush x:Key="DataGridAltRowBgBrush" Color="#161F38"/>
    <SolidColorBrush x:Key="DataGridHeaderBgBrush" Color="#111B33"/>
    <SolidColorBrush x:Key="DataGridHeaderTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#2D3B5A"/>
    <SolidColorBrush x:Key="DataGridSelectedRowBrush" Color="#2A3F66"/>

    <!-- Accent & Status Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

    <!-- Progress & Badges -->
    <SolidColorBrush x:Key="ProgressBarBgBrush" Color="#24344D"/>
    <SolidColorBrush x:Key="BadgeNeutralBgBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BadgeNeutralTextBrush" Color="#94A3B8"/>

</ResourceDictionary>
