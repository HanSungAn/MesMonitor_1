<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main Backgrounds (Bright & Clean) -->
    <SolidColorBrush x:Key="BgWindowBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FooterBgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubCardBgBrush" Color="#F8FAFC"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SubCardBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E2E8F0"/>

    <!-- Text Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#94A3B8"/>

    <!-- Inputs & Controls -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="DropdownBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DropdownItemHoverBrush" Color="#F1F5F9"/>

    <!-- Navigation Menu -->
    <SolidColorBrush x:Key="NavButtonTextBrush" Color="#334155"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="NavButtonHoverTextBrush" Color="#0284C7"/>

    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridRowBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridAltRowBgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DataGridHeaderBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="DataGridHeaderTextBrush" Color="#475569"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DataGridSelectedRowBrush" Color="#E0F2FE"/>

    <!-- Accent & Status Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

    <!-- Progress & Badges -->
    <SolidColorBrush x:Key="ProgressBarBgBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BadgeNeutralBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BadgeNeutralTextBrush" Color="#475569"/>

</ResourceDictionary>
