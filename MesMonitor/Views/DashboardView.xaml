<UserControl x:Class="MesMonitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="260"/>  <!-- Charts -->
            <RowDefinition Height="*"/>    <!-- Andon Lines & Alarms -->
        </Grid.RowDefinitions>

        <!-- 1. KPI Cards Row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Plan -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="당일 생산 목표" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalPlanQty, StringFormat='{}{0:N0} EA'}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{DynamicResource AccentCyanBrush}"/>
                    <TextBlock Text="전체 라인 합산 계획치" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Produced -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="실시간 생산 실적" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalProducedQty, StringFormat='{}{0:N0} EA'}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="진행률 순항 중" Foreground="{DynamicResource SuccessBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Defect & Quality -->
            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="불량 수량 / 불량률" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TotalDefectQty, StringFormat='{}{0:N0} EA'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                    <TextBlock Text="허용 한계치(2.0%) 이내 안정" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Overall OEE -->
            <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="종합 설비 효율 (OEE)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding OverallOee, StringFormat='{}{0:F1} %'}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="목표 OEE(85.0%) 초과 달성" Foreground="{DynamicResource SuccessBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Charts Row -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- OEE Doughnut Chart -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="종합설비효율 (OEE) 3대 지표" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <lvc:PieChart Grid.Row="1" 
                                  Series="{Binding OeeSeries}" 
                                  LegendPosition="Right" 
                                  LegendTextPaint="{Binding ChartLegendTextPaint}"
                                  TooltipBackgroundPaint="{Binding ChartTooltipBgPaint}"
                                  TooltipTextPaint="{Binding ChartTooltipTextPaint}"
                                  Background="{DynamicResource CardBgBrush}"
                                  Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- Hourly Production Bar Chart -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="시간대별 계획 대비 생산 추이" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="목표 vs 실적 비교" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    </DockPanel>
                    <lvc:CartesianChart Grid.Row="1" 
                                        Series="{Binding HourlyProductionSeries}" 
                                        XAxes="{Binding HourlyXAxes}" 
                                        YAxes="{Binding HourlyYAxes}" 
                                        LegendPosition="Top" 
                                        LegendTextPaint="{Binding ChartLegendTextPaint}"
                                        TooltipBackgroundPaint="{Binding ChartTooltipBgPaint}"
                                        TooltipTextPaint="{Binding ChartTooltipTextPaint}"
                                        Background="{DynamicResource CardBgBrush}"
                                        Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Row: Andon Board & Recent Alarms -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Andon Line Status Cards -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="실시간 라인 가동 현황 (Andon Monitor)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="자동 갱신 중 (1.5s)" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" FontSize="11"/>
                    </DockPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Line Name & State Badge -->
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding LineName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border HorizontalAlignment="Right" CornerRadius="4" Padding="8,2"
                                                    Background="{Binding State, Converter={StaticResource MachineStateToBrushConverter}}">
                                                <TextBlock Text="{Binding State}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Target Product -->
                                        <TextBlock Grid.Row="1" Text="{Binding ProductName}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>

                                        <!-- Progress Details StackPanel -->
                                        <StackPanel Grid.Row="2" Margin="0,2,0,4">
                                            <!-- 상단: 진행률 텍스트 및 수량 -->
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock Text="{Binding ProgressRate, StringFormat='{}진행률: {0:F1}%'}" FontSize="10" Foreground="{DynamicResource AccentCyanBrush}"/>
                                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding ProducedQty}"/>
                                                    <Run Text="/"/>
                                                    <Run Text="{Binding TargetQty}"/>
                                                    <Run Text=" EA"/>
                                                </TextBlock>
                                            </DockPanel>

                                            <!-- 하단: 프로그레스 바 -->
                                            <ProgressBar Value="{Binding ProgressRate, Mode=OneWay}" Maximum="100" Height="6" Background="{DynamicResource ProgressBarBgBrush}" Foreground="{DynamicResource AccentCyanBrush}"/>
                                        </StackPanel>

                                        <!-- Sensors Snapshot -->
                                        <DockPanel Grid.Row="3" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Temperature, StringFormat='{}온도: {0:F1}°C'}" FontSize="10" Foreground="{DynamicResource WarningBrush}"/>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding Rpm, StringFormat='{}RPM: {0:N0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Recent Alarms Feed -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource CardBgBrush}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="실시간 알람 &amp; 이상 감지" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ActiveAlarmCount, StringFormat='{}미확인: {0}건'}" HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold"/>
                    </DockPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource SubCardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource AlarmSeverityToBrushConverter}}" CornerRadius="2" Margin="0,0,6,0"/>

                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding EquipmentName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}HH:mm:ss'}" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
