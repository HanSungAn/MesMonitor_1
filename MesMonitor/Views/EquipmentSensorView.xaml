<UserControl x:Class="MesMonitor.Views.EquipmentSensorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Equipment Selector & Control Bar -->
            <RowDefinition Height="Auto"/> <!-- Sensor Metrics Cards -->
            <RowDefinition Height="*"/>    <!-- Realtime Trend Chart & Status Info -->
        </Grid.RowDefinitions>

        <!-- 1. Equipment Selector & Control Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="대상 설비 선택:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding EquipmentList}" 
                              SelectedItem="{Binding SelectedEquipment}" 
                              DisplayMemberPath="LineName" 
                              Width="260" Height="32" 
                              Background="#111B33" Foreground="#FFFFFF" BorderBrush="#3A506B"/>
                </StackPanel>

                <!-- State Override buttons for simulation -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="설비 상태 제어 시뮬레이션:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <Button Content="정상 가동" Command="{Binding ChangeStateCommand}" CommandParameter="Running" 
                            Background="#065F46" Foreground="#34D399" Margin="0,0,6,0" Padding="12,6" BorderThickness="0"/>
                    <Button Content="일시 대기" Command="{Binding ChangeStateCommand}" CommandParameter="Idle" 
                            Background="#78350F" Foreground="#FBBF24" Margin="0,0,6,0" Padding="12,6" BorderThickness="0"/>
                    <Button Content="경보 발생" Command="{Binding ChangeStateCommand}" CommandParameter="Alarm" 
                            Background="#7F1D1D" Foreground="#F87171" Padding="12,6" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Sensor Current Values Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Temperature -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="챔버 / 노즐 온도" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentTemperature, StringFormat='{}{0:F1} °C'}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EF4444"/>
                    <TextBlock Text="경고 상한: 85°C" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pressure -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="유압 / 공압 압력" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentPressure, StringFormat='{}{0:F2} bar'}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="#38BDF8"/>
                    <TextBlock Text="정상 범위: 4.5 ~ 6.5" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Vibration -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="스핀들 진동 (G)" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentVibration, StringFormat='{}{0:F2} G'}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="#F59E0B"/>
                    <TextBlock Text="진동 허용치: 1.5G 미만" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- RPM -->
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="회전속도 (RPM)" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentRpm, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="#10B981"/>
                    <TextBlock Text="동기 회전수 99.2%" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Power -->
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="실시간 소비전력" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentPower, StringFormat='{}{0:F1} kW'}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="#A78BFA"/>
                    <TextBlock Text="누적 전력 원단위 준수" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Real-time Multi-Sensor Chart & Specs -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LiveCharts2 Realtime Streaming Chart -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="실시간 센서 트렌드 (Multi-Axis Time-Series)" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9"/>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="LIVE STREAM" Foreground="#60A5FA" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="다중 Y축 (온도 vs 압력/진동)" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    </DockPanel>

                    <lvc:CartesianChart Grid.Row="1" Series="{Binding SensorSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Top" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- Equipment Diagnostics & Details Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="설비 제원 및 임계 기준" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" Margin="0,0,0,12"/>

                        <!-- Details Table -->
                        <Border Background="#161F38" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="설비 코드" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedEquipment.LineId}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Separator Background="#2D3B5A" Margin="0,4"/>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="현재 가동 상태" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedEquipment.State}" HorizontalAlignment="Right" FontWeight="Bold" 
                                               Foreground="{Binding SelectedEquipment.State, Converter={StaticResource MachineStateToBrushConverter}}"/>
                                </DockPanel>
                                <Separator Background="#2D3B5A" Margin="0,4"/>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="진행 지시번호" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedEquipment.CurrentOrderNo}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Separator Background="#2D3B5A" Margin="0,4"/>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="종합 가동 효율" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedEquipment.Efficiency, StringFormat='{}{0:F1} %'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#34D399"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="예지보전 임계치 가이드" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" Margin="0,6,0,8"/>
                        <Border Background="#161F38" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="• 안전 (Normal): 온도 &lt; 75°C, 진동 &lt; 1.2G" Foreground="#34D399" FontSize="11" Margin="0,2"/>
                                <TextBlock Text="• 주의 (Warning): 온도 75~85°C, 진동 1.2~1.5G" Foreground="#FBBF24" FontSize="11" Margin="0,2"/>
                                <TextBlock Text="• 위험 (Critical): 온도 &gt; 85°C, 진동 &gt; 1.5G" Foreground="#F87171" FontSize="11" Margin="0,2"/>
                                <TextBlock Text="• 이상 감지 시 설비 자동 인터록 및 알람 발령" Foreground="#94A3B8" FontSize="10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

