<!-- 
    [렌더링 및 디스플레이 최적화 옵션]
    - TextOptions.TextFormattingMode="Display" : 폰트 크기/자간의 픽셀 정렬 가독성 향상
    - TextOptions.TextRenderingMode="ClearType" : LCD 모니터 서브픽셀 클리어타입 렌더링
    - UseLayoutRounding="True" / SnapsToDevicePixels="True" : 픽셀 경계선 번짐(Blur) 방지
-->
<Window x:Class="MesMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MesMonitor"
        xmlns:vm="clr-namespace:MesMonitor.ViewModels"
        mc:Ignorable="d"
        Title="MES Solution - Smart Factory Operations Center" 
        Height="850" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- App Brand / Logo -->
                    <RowDefinition Height="*"/>    <!-- Navigation Buttons -->
                    <RowDefinition Height="Auto"/> <!-- Footer Info -->
                </Grid.RowDefinitions>

                <!-- Brand / Logo -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#0284C7" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="M" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MES CORE" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Smart Operations v2.4" FontSize="10" Foreground="#0284C7"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav Menu Buttons -->
                <ScrollViewer Grid.Row="1" Margin="10,16,10,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MAIN MENU" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,0,0,8"/>

                        <!-- 1. Dashboard -->
                        <Button Style="{StaticResource NavButtonStyle}" 
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="실시간 생산 대시보드" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Equipment -->
                        <Button Style="{StaticResource NavButtonStyle}" 
                                Command="{Binding NavigateCommand}" CommandParameter="Equipment">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="설비 센서 트렌드" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Quality & SPC -->
                        <Button Style="{StaticResource NavButtonStyle}" 
                                Command="{Binding NavigateCommand}" CommandParameter="Quality">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="품질 &amp; SPC 관리도" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Work Order -->
                        <Button Style="{StaticResource NavButtonStyle}" 
                                Command="{Binding NavigateCommand}" CommandParameter="WorkOrder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="작업지시 및 실적" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SYSTEM &amp; CONFIG" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,20,0,8"/>

                        <!-- 5. History & Settings -->
                        <Button Style="{StaticResource NavButtonStyle}" 
                                Command="{Binding NavigateCommand}" CommandParameter="History">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="알람 이력 &amp; 기준정보" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Info -->
                <Border Grid.Row="2" Padding="16,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource FooterBgBrush}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="운영자" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="Administrator" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="네트워크" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,4,0"/>
                                <TextBlock Text="ONLINE" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/> <!-- Top Header Bar -->
                <RowDefinition Height="*"/>  <!-- Dynamic Page Content -->
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <!-- Title of current view -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentViewModel.Title}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeNeutralBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="제1공장 스마트제조 라인" Foreground="{DynamicResource BadgeNeutralTextBrush}" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- Right Controls: Theme Switch, Clock, Indicator -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Theme Toggle Button -->
                        <Button Command="{Binding ToggleThemeCommand}" 
                                Content="{Binding ThemeButtonText}" 
                                Height="32" Padding="12,0" Margin="0,0,12,0" 
                                Background="{DynamicResource SubCardBgBrush}" 
                                Foreground="{DynamicResource TextPrimaryBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                FontSize="12" FontWeight="SemiBold" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Realtime Clock -->
                        <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="{Binding CurrentTimeString}" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- System Ready Badge -->
                        <Border Background="#065F46" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="SYSTEM READY" Foreground="#34D399" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dynamic Page Content using ContentControl & App.xaml DataTemplates -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
